<?xml version="1.0" encoding="utf-8"?>
<project>
	<!-- _________________________ Application Settings _________________________ -->

	<app title="Friday Night Funkin': Mixtape Engine" file="Mixtape" packageName="com.z11gaming.mixtapeengine" package="com.z11gaming.mixtapeengine" main="Main" version="0.8.0" company="Z11Gaming" />

	<!--Switch Export with Unique ApplicationID and Icon-->
	<set name="APP_ID" value="0x0100f6c013bbc000" />

	<!-- NOTE TO SELF: DISABLE THIS IF ISSUES ARE FOUND -->
	<haxedef name="LINC_LUA_RELATIVE_DYNAMIC_LIB"/> <!-- stable luas PUT AFTER FIRST LINE WITH APP NAME AND ETC -->

	<!--The flixel preloader is not accurate in Chrome. You can use it regularly if you embed the swf into a html file
		or you can set the actual size of your file manually at "FlxPreloaderBase-onUpdate-bytesTotal"-->
	<!-- <app preloader="Preloader" resizable="true" /> -->
	<app preloader="backend.FunkinPreloader" />

	<!--Minimum without FLX_NO_GAMEPAD: 11.8, without FLX_NO_NATIVE_CURSOR: 11.2-->
	<set name="SWF_VERSION" value="11.8" />

	<!-- ______________________ MIXTAPE ENGINE CUSTOMIZATION ______________________ -->

	<define name="MODS_ALLOWED" if="desktop" />
	<define name="HSCRIPT_ALLOWED" if="desktop" />
	<define name="LUA_ALLOWED" if="desktop" />
	<define name="PYTHON_ALLOWED" if="desktop" />
	<define name="ACHIEVEMENTS_ALLOWED" />
	<define name="DISCORD_ALLOWED" />
	<define name="TRANSLATIONS_ALLOWED" />
	<define name="IRIS_DEBUG"/>
	<define name="ARCHIPELAGO_ALLOWED"/>
	<define name="MECHANICS_MOD_ALLOWED"/>
	<define name="CHECK_FOR_UPDATES"/>
	<define name="TITLE_SCREEN_EASTER_EGG"/>
	<define name="NATIVE_LOOKUP" if="MODS_ALLOWED" />
	<define name="OPENFL_LOOKUP"/>
	<define name="TOUCH_HERE_TO_PLAY"/>
	<define name="MODCHARTS_NOTITG_ALLOWED" if="desktop || mobile" />

	<!-- so that the things that use this can have it-->
	<define name="PE_MOD_COMPATIBILITY"/>
	<define name="ALLOW_DEPRECATION"/>
	<define name="EASED_SVs"/>
	<define name="MULTICORE_LOADING" if="desktop" />
	<define name="loadBenchmark" if="MULTICORE_LOADING"/>
	<define name="CROSSPLATFORM"/>

	<haxedef name="traceShaderLineNumbers"/>

	<define name="MULTITHREADED_LOADING" /> <!-- UNCOMMENTING THIS LINE WILL ENABLE MULTITHREADED LOADING, WHICH IMPROVES LOADING TIMES, BUT WITH A LOW CHANCE FOR THE GAME FREEZE ON SONG LOAD -->
	<define name="SHOW_LOADING_SCREEN" />
	<define name="PSYCH_WATERMARKS"/> <!-- DELETE THIS TO REMOVE THE PSYCH LOGO FROM LOADING SCREEN -->
	<define name="SCRIPTABLE_STATES" if="HSCRIPT_ALLOWED" />

	<!-- Build-time type and source collection system -->
	<define name="BUILD_MACRO_ENABLED" if="desktop" />

	<!-- YScript Compiler (YSComp) - Convert .ys files to Haxe modules -->
	<define name="YSCOMP_ENABLED" if="desktop" />
	<define name="YSCOMP_MODE" value="FullConversion" /> <!-- Options: InterpreterMode, FullConversion -->
	<define name="YSCOMP_PRESERVE_ORIGINAL" value="true" />
	<define name="YSCOMP_DEBUG_INFO" value="true" />

	<define name="BASE_GAME_FILES" />
	<define name="VIDEOS_ALLOWED" if="windows || linux || android || mac" unless="32bits"/> <!-- IF YOU WANT TO USE VIDEOS ON YOUR SOURCE MOD, GET THIS LINE OUTSIDE OF THE SECTION -->

	<section if="officialBuild">
		<define name="TITLE_SCREEN_EASTER_EGG"/>
	</section>

	<!-- Apparently I can just drop this in and it'll work so i'll be the judge of that -->
	<!-- As it turns out, you can indeed just drop it in and it'll work -->

	<!-- ____________________________ Window Settings ___________________________ -->

	<!--These window settings apply to all targets-->
	<window width="1280" height="720" fps="60" background="#000000" hardware="true" vsync="false" allow-high-dpi="true" />
	<hardware allow-shaders="true" require-shaders="false" />
	<window context="opengl" />

	<!--HTML5-specific-->
	<window if="html5" resizable="true" />

	<!--Desktop-specific-->
	<window if="desktop" orientation="landscape" fullscreen="false" resizable="true" vsync="false"/>

	<!--Mobile-specific-->
	<window if="mobile" orientation="landscape" fullscreen="true" width="0" height="0" resizable="false"/>

	<!--Switch-specific-->
	<window if="switch" orientation="landscape" fullscreen="true" width="0" height="0" resizable="true" />

	<!-- _____________________________ Path Settings ____________________________ -->

	<set name="BUILD_DIR" value="export/debug" if="debug" />
	<set name="BUILD_DIR" value="export/release" unless="debug" />
	<set name="BUILD_DIR" value="export/32bit" if="32bits" />
	<!-- because you need to rebuild the game everytime you enable tracy -->
	<set name="BUILD_DIR" value="export/tracy" if="TRACY_ENABLED" />
	<classpath name="source" />

	<!-- __________________________ Game Assets & Etc. __________________________ -->

	<!-- Turn on Crash Handler -->
	<define name="CRASH_HANDLER" if="desktop" />

	<!-- Assets -->
	<assets path=".flight" />
	<assets path="assets/fonts" />
	<assets path="assets/modchart" />
	<assets path="assets/shared"        exclude="*.ogg" if="web"/>
	<assets path="assets/shared"        exclude="*.mp3" unless="web"/>
	<assets path="assets/embed"         exclude="*.ogg" if="web" embed="true"/>
	<assets path="assets/embed"         exclude="*.mp3" unless="web" embed="true"/>
	<assets path="assets/videos"        if="VIDEOS_ALLOWED"/>
	<assets path="assets/songs"         exclude="*.ogg" if="web"/>
	<assets path="assets/songs"         exclude="*.mp3" unless="web"/>
	<assets path="assets/week_assets"   rename="assets" exclude="*.ogg" if="web"/>
	<assets path="assets/week_assets"   rename="assets" exclude="*.mp3" unless="web"/>

	<section if="TRANSLATIONS_ALLOWED">
		<assets path="assets/translations" rename="assets" exclude="*.ogg" if="web"/>
		<assets path="assets/translations" rename="assets" exclude="*.mp3"  unless="web"/>
	</section>

	<section if="BASE_GAME_FILES">
		<assets path="assets/base_game" rename="assets" exclude="*.ogg" if="web"/>
		<assets path="assets/base_game" rename="assets" exclude="*.mp3"  unless="web"/>
		<haxelib name="grig.audio" if="BASE_GAME_FILES"/>
		<haxelib name="funkin.vis" if="BASE_GAME_FILES"/>
		<haxelib name="FlxPartialSound" version="git"/>
	</section>

	<section if="MODS_ALLOWED">
		<assets path='example_mods' rename='mods' embed='false' type='template' unless="mac"/>
		<assets path='example_mods' rename='mods' embed='false' if="mac"/>
		<assets path='list.txt' rename='modsList.txt' />
	</section>
	<assets path='art/readme.txt' rename='do NOT readme.txt' />

	<!-- OpenAL config -->
	<section if="desktop">
		<assets path="alsoft.txt" rename="plugins/alsoft.ini" type="text" if="windows"/>
		<assets path="alsoft.txt" rename="plugins/alsoft.conf" type="text" unless="windows"/>
	</section>

	<!-- _______________________________ Libraries ______________________________ -->

	<haxelib name="flixel" version="5.6.2"/>
	<haxelib name="flixel-addons" version="3.3.0"/>
	<haxelib name="tjson" version="1.4.0"/>
	<haxelib name="noisehx" />
	<haxelib name="codename" />

	<!--Mixtape stuff needed-->
	<haxelib name="openfl" version="9.4.1"/> <!-- Game engine backend -->
	<!--haxelib name="openflCamera" />
	<haxelib name="openflMicrophone" /-->
	<haxelib name="haxeui-core" version="1.7.0"/> <!-- UI framework -->
	<haxelib name="haxeui-flixel" version="1.7.0"/> <!-- Integrate HaxeUI with Flixel -->
	<haxelib name="flixel-text-input" /> <!-- Improved text field rendering for HaxeUI -->
	<haxelib name="flixel-ui" version="2.6.2"/>
	<haxelib name="linc_dialogs" version="git" if="desktop" />
	<haxelib name="flixel-animate" />
	<haxelib name="thx.core" version="git"/>
	<!--so that the engine will still allow it without that exact library to exist-->
	<define name="flxanimate"/>
	<haxelib name="extension-harfbuzz" if="linux" />
	<haxelib name="random" version="1.4.1"/>
	<haxelib name="flxrhythmconductor" version="0.2.0"/>


	<!--Uncomment if you want to use moonchart, which allows usage of chart formats from other rhythm games and fnf engines-->
  <haxelib name="moonchart" version="git" if="native"/>

	<!--Psych stuff needed-->
	<haxelib name="linc_luajit" if="LUA_ALLOWED"/>
	<haxelib name="hscript-iris" if="HSCRIPT_ALLOWED" version="1.1.3"/>
	<haxelib name="hxvlc" if="VIDEOS_ALLOWED" version="2.0.1"/>
	<haxelib name="hxdiscord_rpc" version="1.2.4" if="DISCORD_ALLOWED"/>
	<haxelib name="hxpy" version="2.0.0" if="PYTHON_ALLOWED" />

	<!-- Archipelago Stuff-->
	<haxelib name="helder.set" version="0.3.1"/>
	<haxelib name="yaml" version="2.0.1"/>
	<haxelib name="hxWebSockets" />
	<haxelib name="haxe-concurrent" version="5.1.3"/>
	<haxelib name="actuate" version="1.9.0"/>
	<haxelib name="tentools" />
	<haxelib name="systools" />
	<haxelib name="deflatex" version="1.0.0"/>
	<ndll name="systools" haxelib="systools" />

	<!-- Disable Discord IO Thread -->
	<haxedef name="DISCORD_DISABLE_IO_THREAD" if="hxdiscord_rpc" />
	<haxedef name="NO_PRECOMPILED_HEADERS" if="linux" />

	<!-- Enables a terminal log prompt on debug builds -->
	<haxelib name="hxcpp-debug-server" if="debug"/>
	<haxedef name="HXC_LIBVLC_LOGGING" if="VIDEOS_ALLOWED debug" />
	<haxedef name="HXVLC_NO_SHARE_DIRECTORY" if="VIDEOS_ALLOWED" />
	<define name="x86_BUILD" if="32bits" />

	<!--Avoid memory leaks with for loops in HScript-->
	<haxedef name="loop_unroll_max_cost" value="25" />

	<!-- Tracy Profiler -->
	<!-- <haxedef name="HXCPP_TRACY" if="desktop" /> -->

	<haxelib name="flxsoundfilters" />

	<haxelib name="faxe" if='switch'/>

	<section if="MULTICORE_LOADING false">
		<define name="traceLoading"/>
		<define name="loadBenchmark"/>


	</section>

	<haxedef name="HX_HAS_ATOMIC"/>

	<!-- ______________________________ Haxedefines _____________________________ -->

	<!--Enable the Flixel core recording system-->
	<!--<haxedef name="FLX_RECORD" />-->

	<!--Disable the right and middle mouse buttons-->
	<!-- <haxedef name="FLX_NO_MOUSE_ADVANCED" /> -->

	<!--Disable the native cursor API on Flash-->
	<!--<haxedef name="FLX_NO_NATIVE_CURSOR" />-->

	<!--Optimise inputs, be careful you will get null errors if you don't use conditionals in your game-->
	<!-- <haxedef name="FLX_NO_MOUSE" if="mobile" /> -->
	<!-- <haxedef name="FLX_NO_KEYBOARD" if="mobile" /> -->
	<!-- <haxedef name="FLX_NO_TOUCH" if="desktop" /> -->
	<!--<haxedef name="FLX_NO_GAMEPAD" />-->

	<!--Disable the Flixel core sound tray-->
	<!--<haxedef name="FLX_NO_SOUND_TRAY" />-->

	<!--Disable the Flixel sound management code-->
	<!--<haxedef name="FLX_NO_SOUND_SYSTEM" />-->

	<haxedef name="analyzer-optimize" unless="debug" />

	<!--Optimise inputs, be careful you will get null errors if you don't use conditionals in your game-->
	<haxedef name="FLX_NO_TOUCH" if="desktop" />

	<!--Disable the Flixel core focus lost screen-->
	<haxedef name="FLX_NO_FOCUS_LOST_SCREEN" />

	<!-- Show debug traces for hxCodec -->
	<haxedef name="HXC_DEBUG_TRACE" if="debug" />

	<!--Disable the Flixel core debugger. Automatically gets set whenever you compile in release mode!-->
	<haxedef name="FLX_NO_DEBUG" unless="debug" />

	<!--Enable this for Nape release builds for a serious peformance improvement-->
	<haxedef name="NAPE_RELEASE_BUILD" unless="debug" />

	<!--Used for Izzy Engine's crash handler-->
	<section if="cpp">
		<haxedef name="HXCPP_M32" if="32bit" />
		<haxedef name="HXCPP_DEBUG_LINK" if="debug" />
		<haxedef name="HXCPP_CHECK_POINTER" />
		<haxedef name="HXCPP_STACK_LINE" />
		<haxedef name="HXCPP_STACK_TRACE" />
		<haxedef name="HXCPP_CATCH_SEGV" />
	</section>

	<section if="TRACY_ENABLED">
		<haxedef name="HXCPP_TELEMETRY"/>
		<haxedef name="HXCPP_TRACY"/>
		<haxedef name="HXCPP_TRACY_MEMORY"/>
		<haxedef name="HXCPP_TRACY_ON_DEMAND"/>
	</section>

	<section if="desktop">
		<!--Enable Handle Error-->
		<haxedef name="openfl_enable_handle_error" if="${openfl >= 9.4.0}" />
		<!--Undefinitions-->
		<undefine name="openfl-disable-handle-error" if="debug" unless="${openfl >= 9.4.0}" />
	</section>

	<!--Allow working memory greater than 1 Gig-->
	<haxedef name="HXCPP_GC_BIG_BLOCKS" if="cpp"/>

	<!--Disable deprecated warnings-->
	<haxedef name='no-deprecation-warnings' unless="debug" />

	<!-- Haxe 4.3.0+: Enable pretty syntax errors and stuff. -->
	<!-- pretty (haxeflixel default), indent, classic (haxe compiler default) -->
	<haxedef name="message.reporting" value="pretty" unless="{haxe &lt; 4.3.1}"/>
	<haxedef name="message.log-format" value="pretty" unless="{haxe &lt; 4.3.1}"/>

	<haxeflag name="-dce" value="no" />
	<haxedef name="analyzer-optimize" />

	<!--Macro fixes-->
	<haxeflag name="--macro" value="allowPackage('flash')" />
	<haxeflag name="--macro" value="include('my.pack')" />
	<haxeflag name="--macro" value="yutautil.RuntimeTypedef.processTypedef()" />
	<haxeflag name="--macro" value="yutautil.VoidFall.randomFailure()" />
	<haxeflag name="--macro" value="addMetadata('@:build(backend.macro.pslice.FlxMacro.buildFlxBasic())', 'flixel.FlxBasic')" />
	<haxeflag name="--macro" value="include('animate')" />

	<!-- Patched type system - enable field validation on all classes -->
	<!-- <haxeflag name="macro" value="yutautil.Patched.PatchedMacro.init()" /> -->

	<haxeflag name="--resource" value="assets/embed/apworld/fridaynightfunkin.apworld@apworld" />
	<haxeflag name="--resource" value="example_mods/modTemplate.zip@modTemp" />

	<section if="HSCRIPT_ALLOWED">
		<haxedef name="hscriptPos" if="HSCRIPT_ALLOWED" />
		<haxelib name="hscript" version="2.5.0"/>
		<define name="hscriptPos"/>

		<haxeflag name="--macro" value="include('funkin')" />
	</section>

	<!-- Enable this on platforms which do not support dropping files onto the window. -->
	<haxedef name="FILE_DROP_UNSUPPORTED" if="mac" />
	<section unless="FILE_DROP_UNSUPPORTED">
		<haxedef name="FILE_DROP_SUPPORTED" />
	</section>

	<!-- Haxe 4.3.0+: Enable pretty syntax errors and stuff. -->
	<!-- pretty (haxeflixel default), indent, classic (haxe compiler default) -->
	<haxedef name="message.reporting" value="pretty" />

	<define name="NO_PRECOMPILED_HEADERS" if="LUA_ALLOWED linux" />

	<!-- Javascript breaks with inline for reasons unknown -->
	<haxedef name="no-inline" if="html5"/>

	<!-- Force C99 standard for macOS/iOS to fix zlib compilation with Xcode 16.4 -->
	<haxedef name="HXCPP_CFLAGS" value="-std=c99 -Wno-error=deprecated-non-prototype -Wno-deprecated-declarations -Wno-unused-command-line-argument -Wno-macro-redefined" if="macos || ios" />

	<!-- ____________________________ PlusEngine/FunkinModchart Stuff _______________________________ -->

    <section if="MODCHARTS_NOTITG_ALLOWED">
		<haxedef name="FM_ENGINE" value="PSYCH"/>
    <haxedef name="FM_ENGINE_VERSION" value="1.0"/>
    <haxeflag name="--macro" value="backend.funkinmodchart.backend.macros.Macro.includeFiles()"/>
		<haxeflag name="source/extraParams.hxml" unless="ios"/>
		<haxeflag name="--macro" value="addMetadata('@:build(backend.funkinmodchart.backend.macros.Macro.buildFlxCamera())', 'flixel.FlxCamera')" if="ios"/>
		<haxeflag name="--macro" value="addMetadata('@:build(backend.funkinmodchart.backend.macros.Macro.buildFlxDrawTrianglesItem())', 'flixel.graphics.tile.FlxDrawTrianglesItem')" if="ios"/>
		<haxeflag name="--macro" value="addMetadata('@:build(backend.funkinmodchart.backend.macros.Macro.addModchartStorage())', 'flixel.FlxBasic')" if="ios"/>
	</section>

	<!-- _________________________________ Custom _______________________________ -->

	<!-- Build-time type collection system using global metadata -->
	<section if="BUILD_MACRO_ENABLED">
		<haxeflag name="--macro" value="yutautil.typeregistry.GlobalTypeMacro.applySelective()" />
	</section>

	<!-- YScript Compiler integration -->
	<section if="YSCOMP_ENABLED">
		<haxeflag name="--macro" value="yutautil.YSComp.initialize()" />
	</section>

	<assets path='art/icons/iconOG.png' rename='icon.png' if="linux" />

	<icon path="art/icons/icon16.png" size='16'/>
	<icon path="art/icons/icon32.png" size='32'/>
	<icon path="art/icons/icon64.png" size='64'/>
	<icon path="art/icons/iconOG.png" />
</project>
