{
  "name": "yscript-language-support",
  "displayName": "YScript Language Support",
  "description": "YScript syntax highlighting and language server with Haxe integration",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Programming Languages",
    "Language Packs",
    "Other"
  ],
  "keywords": [
    "yscript",
    "haxe",
    "game development",
    "mixtape engine",
    "scripting"
  ],
  "main": "./client/out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "yscript",
        "aliases": [
          "YScript",
          "yscript"
        ],
        "extensions": [
          ".ys",
          ".yscript"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "yscript",
        "scopeName": "source.yscript",
        "path": "./syntaxes/yscript.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.haxe": "haxe",
          "meta.embedded.lua": "lua"
        }
      }
    ],
    "configuration": {
      "type": "object",
      "title": "YScript",
      "properties": {
        "yscript.trace.server": {
          "scope": "window",
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication between VS Code and the YScript language server."
        },
        "yscript.validate.enable": {
          "scope": "resource",
          "type": "boolean",
          "default": true,
          "description": "Enable/disable YScript validation."
        },
        "yscript.completion.enable": {
          "scope": "resource",
          "type": "boolean",
          "default": true,
          "description": "Enable/disable YScript auto-completion."
        },
        "yscript.hover.enable": {
          "scope": "resource",
          "type": "boolean",
          "default": true,
          "description": "Enable/disable YScript hover information."
        },
        "yscript.haxe.integration": {
          "scope": "resource",
          "type": "boolean",
          "default": true,
          "description": "Enable Haxe integration for embedded code blocks."
        }
      }
    },
    "commands": [
      {
        "command": "yscript.restart",
        "title": "Restart YScript Language Server",
        "category": "YScript"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -b",
    "watch": "tsc -b -w",
    "package": "vsce package --allow-star-activation",
    "postinstall": "cd client && npm install && cd ../server && npm install && cd .."
  },
  "devDependencies": {
    "@types/node": "16.x",
    "@types/vscode": "^1.74.0",
    "@vscode/vsce": "^2.15.0",
    "typescript": "^4.9.4"
  },
  "activationEvents": [
    "onLanguage:yscript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/your-repo/mixtape-engine-rework"
  },
  "license": "MIT",
  "publisher": "mixtape-engine"
}
