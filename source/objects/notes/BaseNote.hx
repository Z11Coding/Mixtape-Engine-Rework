package objects.notes;

import backend.animation.PsychAnimationController;
import backend.modchartSystem.NoteData;
import objects.funkin.graphics.ZSpriteProjected;
import objects.notes.NoteTypesConfig;
import objects.notes.SustainSplash;
import shaders.RGBPalette.RGBShaderReference;
import shaders.RGBPalette;

/**
 * The BaseNote Object is purely so that the Sustains and Notes can be treated the same while still being different
 * Is there a better way to do this? Yes. Do I know what that way is? Nope.
 *
 * Oh, and this is literally only to store the shared variables between [Note] and [SustainNote] so they can be registered the same.
 * That's it lol
**/

class BaseNote extends ZSpriteProjected
{
	/**
   * The Y Offset of the note.
   */
  public var yOffset:Float = 0.0;

	public var extraData:Map<String, Dynamic> = new Map<String, Dynamic>();
	public var noteModData:NoteData;

	public var parentST:Float = 0;
	public var parentSL:Float = 0;
	public var strumTime:Float = 0;
	public var mustPress:Bool = false;
	public var doOppStuff:Bool = false;
	public var noteData:Int = 0;
	public var canBeHit:Bool = false;
	public var tooLate:Bool = false;
	public var tooEarly:Bool = true;
	public var wasGoodHit:Bool = false;
	public var missed:Bool = false;
	public var ignoreNote:Bool = false;
	public var hitByOpponent:Bool = false; //For Opponent notes

	public var blockHit:Bool = false; // only works for player
	public var forceBlockHit:Bool = false;

	public var noteDensity:Float = 1;

	public var sustainLength:Float = 0;
	public var isSustainNote:Bool = false;
	public var isSustainEnd:Bool = false;

	public var eventName:String = '';
	public var eventLength:Int = 0;
	public var eventVal1:String = '';
	public var eventVal2:String = '';

	public static var globalRgbShaders:Array<RGBPalette> = [];
	public var inEditor:Bool = Type.getClassName(Type.getClass(FlxG.state)) == 'editors.ChartingState';

	public var animSuffix:String = '';
	public var gfNote:Bool = false;
	public var exNote:Bool = false;
	public var earlyHitMult:Float = 0.5;
	public var lateHitMult:Float = 1;
	public var lowPriority:Bool = false;

	public static final SUSTAIN_SIZE:Int = 44;
	public static final swagWidth:Float = 160 * 0.7;

	public static var defaultNoteSkin(default, never):String = 'noteSkins/NOTE_assets';

	public var noteSplashData:NoteSplashData = {
		disabled: false,
		texture: null,
		antialiasing: !PlayState.isPixelStage,
		useGlobalShader: false,
		useRGBShader: (PlayfieldManager.SONG != null) ? (!PlayfieldManager.SONG.disableNoteRGB) : true,
		r: -1,
		g: -1,
		b: -1,
		a: 1
	};
	public var noteHoldSplash:SustainSplash;

	// Lua shit
	public var noteSplashDisabled:Bool = false;

	public var offsetX:Float = 0;
	public var offsetY:Float = 0;
	public var offsetAngle:Float = 0;
	public var multAlpha:Float = 1;
	public var multSpeed:Float = 1;

	public var copyX:Bool = true;
	public var copyY:Bool = true;
	public var copyAngle:Bool = false;
	public var copyAlpha:Bool = true;
	public var copyScaleX:Bool = true;
	public var copyScaleY:Bool = true;

	public var hitHealth:Float = 0.023;
	public var missHealth:Float = 0.0475;
	public var rating:String = 'unknown';
	public var ratingMod:Float = 0; //9 = unknown, 0.25 = shit, 0.5 = bad, 0.75 = good, 1 = sick
	public var ratingDisabled:Bool = false;

	public var sustainScale:Float = 1.0;

	public var noAnimation:Bool = false;
	public var noMissAnimation:Bool = false;
	public var hitCausesMiss:Bool = false;
	public var distance:Float = 2000; //plan on doing scroll directions soon -bb

	public var pixelNote:Bool = false;

	var changeSize:Bool = false;

	// Mixtape Stuff
	public var row:Int = 0;
	public var prevNote:Note;
	public var nextNote:Note;
	public var cod:String = null;
	public var alphaLimit:Float = 1;
	public var expectedData:Int = -1;
	public var autoGenerated:Bool = false;
	public var changeAnim:Bool = true;
	public var publicTexture:String = '';
	public var botNote:Bool = false;
	public static var defaultWidth:Float = 0;
	public static var defaultHeight:Float = 0;

	//Action Engine Stuff
	public var noteIndex:Int = -1;

	// Archipelago Stuff
	private var isCheck:Bool = false;
	private var checkInfo:{note:Note, loc:Int};
	public var isMine:Bool = false;
	public var isAlert:Bool = false;
	public var isHeal:Bool = false;
	public var isFreeze:Bool = false;
	public var isFakeHeal:Bool = false;
	public var trueNoteData:Int = 0;
	public var specialNote:Bool = false;
	public var ignoreMiss:Bool = false;
	public var spinAmount:Float = 0;
	public var rootNote:Note;
	public var formerPress:Bool = false;
	var justMixedUp:Bool = false;
	var posTween:FlxTween;

	//Base Game Stuff
	// The Hue, Saturation, Value Shader attached to this note sprites. Mainly used for quant coloured note styles
  public var hsvShader:HSVNotesShader;
	public var vwooshing:Bool = false;

	//WITF Engine Stuff
	// Multiplies the hitWindow size by this amount. Unused if FEATURE_WITF_INPUTS is enabled.
  public var hitWindowMultiplier:Float = 1;

	public function new()
	{
		super();

		noteModData = new NoteData();
	}
}
